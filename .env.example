# Required
DISCORD_TOKEN=
GUILD_ID=

# Optional
DATABASE_PATH=./data/grimoire.db
PORT=8080
LOG_LEVEL=info

# Build label posted by /settings bot-meta. mise deploy fills this in.
BUILD_VERSION=

# Optional first-boot seed. /welcome setup writes the same values to SQLite.
WELCOME_CHANNEL_ID=
BASE_ROLE_ID=

# Optional first-boot seed for /settings stats.
STATS_CHANNEL_ID=

# RSS polling
RSS_POLL_INTERVAL=1h
RSS_MAX_ATTACHMENT_BYTES=10MiB

# Reddit feeds (subreddits and users). Reddit requires a signed-in session:
# paste the reddit_session cookie value from a logged-in browser.
REDDIT_SESSION=
REDDIT_USER_AGENT=
REDDIT_INCLUDE_NSFW=true

# bdsmlr account-site invites. Paste the full Cookie header from a signed-in
# account.bdsmlr.com session (wordpress_logged_in_* and wordpress_sec_*).
BDSMLR_SESSION=

# bbdsmlr analytics from Umami. All three are required to turn reports on.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=

# Stats reports. STATS_TIMES holds the UTC times, or "off" for manual only.
STATS_SITE_URL=https://bdsmlr.zastraea.xyz
STATS_TIMEZONE=UTC
STATS_TIMES=09:00,21:00

# Member ChastiSafe access. /login stores one encrypted code per member. Set
# CHASTISAFE_STORE_KEY to a 32-byte base64 or hex key, or leave it empty to
# generate <database dir>/chastisafe.key with mode 0600.
# CHASTISAFE_STORE_KEY=
CHASTISAFE_BASE_URL=https://chastisafe.com/api-v1

# Required
DISCORD_TOKEN=
GUILD_ID=

# Optional
DATABASE_PATH=./data/grimoire.db
PORT=8080
LOG_LEVEL=info

# Build label posted by /settings bot-meta. mise deploy fills this in.
BUILD_VERSION=

# Optional first-boot seed. /welcome setup writes the same values to SQLite.
WELCOME_CHANNEL_ID=
BASE_ROLE_ID=

# Optional first-boot seed for /settings stats.
STATS_CHANNEL_ID=

# RSS polling
RSS_POLL_INTERVAL=1h
RSS_MAX_ATTACHMENT_BYTES=10MiB

# Reddit feeds (subreddits and users). Reddit requires a signed-in session:
# paste the reddit_session cookie value from a logged-in browser.
REDDIT_SESSION=
REDDIT_USER_AGENT=
REDDIT_INCLUDE_NSFW=true

# bdsmlr account-site invites. Paste the full Cookie header from a signed-in
# account.bdsmlr.com session (wordpress_logged_in_* and wordpress_sec_*).
BDSMLR_SESSION=

# bbdsmlr analytics from Umami. All three are required to turn reports on.
UMAMI_URL=
UMAMI_WEBSITE_ID=
UMAMI_API_KEY=

# Stats reports. STATS_TIMES holds the UTC times, or "off" for manual only.
STATS_SITE_URL=https://bdsmlr.zastraea.xyz
STATS_TIMEZONE=UTC
STATS_TIMES=09:00,21:00

# Roleplay bot. Optional second Discord application. Leave the token empty to
# keep the persona offline. It needs the Message Content intent enabled.
DISCORD_ROLEPLAY_TOKEN=
# Optional. Restrict the persona to one server. Empty serves every guild it is in.
ROLEPLAY_GUILD_ID=
ROLEPLAY_BOT_NAME=Keyholder
# Optional. Leave empty to let any member talk to the persona.
ROLEPLAY_LOCKEE_ROLE_ID=
# Seeds SOUL.md on first boot. The live SOUL on the volume wins afterwards.
ROLEPLAY_SYSTEM_PROMPT_FILE=./prompts/keyholder.md
# ROLEPLAY_SYSTEM_PROMPT=
# Served by /about. A missing file falls back to one in-character line.
ROLEPLAY_ABOUT_FILE=./prompts/about.md
ROLEPLAY_CONTEXT_MESSAGES=15
ROLEPLAY_MAX_CHUNKS=3
ROLEPLAY_TIMEOUT_SECONDS=60
ROLEPLAY_MAX_CONCURRENT=2
ROLEPLAY_RATE_LIMIT_CAPACITY=2
ROLEPLAY_RATE_LIMIT_SECONDS=10

# The persona reads Discord image attachments on the current message and on the
# message it replies to. Detail is auto, low, high, or original.
ROLEPLAY_VISION_ENABLED=true
ROLEPLAY_VISION_MAX_IMAGES=4
ROLEPLAY_VISION_MAX_IMAGE_MB=8
ROLEPLAY_VISION_DETAIL=auto

# Persistent memory and the live SOUL. The directory defaults to the database
# directory plus /roleplay, which is /data/roleplay on Railway. /learn edits
# SOUL.md there without a deployment.
ROLEPLAY_MEMORY_ENABLED=true
# ROLEPLAY_MEMORY_DIR=/data/roleplay
ROLEPLAY_MEMORY_MAX_CHARS=3000
ROLEPLAY_MEMORY_CONTEXT_MAX_CHARS=2500
ROLEPLAY_MEMORY_TIMEOUT_SECONDS=30
ROLEPLAY_SOUL_MAX_CHARS=8000
ROLEPLAY_LEARNING_SESSION_MINUTES=60
ROLEPLAY_LEARNING_TIMEOUT_SECONDS=60
# ROLEPLAY_AUX_MODEL=
ROLEPLAY_AUX_MAX_TOKENS=4096

# Punishment adds this percent of the remaining timed lock, clamped in minutes.
ROLEPLAY_PUNISH_PERCENT=5
ROLEPLAY_PUNISH_MIN_MINUTES=30
ROLEPLAY_PUNISH_MAX_MINUTES=240

# OpenRouter is required when the roleplay bot is on.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash-1017
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Read-only ChastiSafe status for the keyholder persona. The developer code is
# a password: keep it in the environment, never in git. This code belongs to
# the persona only. Members log in separately with /login on the main bot.
ROLEPLAY_CHASTITY_ENABLED=true
CHASTISAFE_KEYHOLDER_CODE=

# Shared ChastiSafe API root for the persona and member commands. Leave empty
# for the default.
# CHASTISAFE_BASE_URL=https://chastisafe.com/api-v1

# Member ChastiSafe access on the main bot. /login stores one encrypted code
# per member. Set CHASTISAFE_STORE_KEY to a 32-byte base64 or hex key, or leave
# it empty to generate <database dir>/chastisafe.key with mode 0600.
# CHASTISAFE_STORE_KEY=
